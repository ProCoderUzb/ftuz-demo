# Copy to .env (or export in your shell). Every value is optional in development.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave unset for SQLite. Production: postgres://user:password@host:5432/ftuz
DATABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Used only when the Central Bank API is unreachable and no rate is cached.
FALLBACK_USD_RATE=12000
