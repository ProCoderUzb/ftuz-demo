# Production settings for docker-compose.yml. Copy to .env and fill in; never commit .env.
# Your public domain (DNS must point here). Use "localhost" to try the stack on your own machine.
DOMAIN=ftuz.example.uz
# Long random strings, e.g. python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
# HSTS: start at 3600 (1 hour), raise to 31536000 once HTTPS works everywhere.
DJANGO_HSTS_SECONDS=3600
# Used only when the Central Bank API is unreachable and no rate is cached.
FALLBACK_USD_RATE=12000
