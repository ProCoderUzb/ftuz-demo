# Copy to /etc/ftuz.env, then: chown root:ftuz /etc/ftuz.env && chmod 640 /etc/ftuz.env
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DATABASE_URL=postgres://ftuz:CHANGE-ME@localhost:5432/ftuz

# Backend lives on ftapi., the web app on ft. (the app is allowed to call the API via CORS)
DJANGO_ALLOWED_HOSTS=ftapi.educationpro.uz
CORS_ALLOWED_ORIGINS=https://ft.educationpro.uz
# Read by `npm run build` (update.sh): where the web app sends API requests
VITE_API_URL=https://ftapi.educationpro.uz/api/v1

# Start at 3600 (1 hour); raise to 31536000 once HTTPS works everywhere.
DJANGO_HSTS_SECONDS=3600
FALLBACK_USD_RATE=12000
